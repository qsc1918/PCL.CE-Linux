<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PCL.Neo.UI.NeoTheme"
        xmlns:ns="clr-namespace:PCL.Neo.UI.Styles">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ns:NeoColorPaletteResourceProvider />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
    
    <StyleInclude Source="Styles/Controls/NeoControls.axaml" />
</Styles>
