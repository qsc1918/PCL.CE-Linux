<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Nullable>enable</Nullable>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>WinExe</OutputType>
        <RootNamespace>PCL</RootNamespace>
        <AssemblyName>PCL</AssemblyName>
        <IsWebBootstrapper>false</IsWebBootstrapper>
        <StartupObject>PCL.Program</StartupObject>
        <PublishUrl>publish\</PublishUrl>
        <PublishSingleFile>true</PublishSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <MapFileExtensions>true</MapFileExtensions>
        <TargetCulture>zh-CN</TargetCulture>
        <UseApplicationTrust>false</UseApplicationTrust>
        <BootstrapperEnabled>true</BootstrapperEnabled>
        <LangVersion>14</LangVersion>
        <Configurations>Beta;Debug;Release;CI</Configurations>
        <Platforms>AnyCPU;x64;ARM64</Platforms>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- app.manifest 为 Windows 专属（DPI/兼容性声明），Linux 无需 -->
        <NoWarn>
            41999;42016;42017;42018;42019;42020;42021;42022;42032;42036;42314;
            VSTHRD002;VSTHRD003;VSTHRD110;VSTHRD200
        </NoWarn>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <OutputPath>bin\Debug\</OutputPath>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>full</DebugType>
        <Optimize>false</Optimize>
        <DefineConstants>TRACE;DEBUG</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'CI' Or '$(Configuration)' == 'DebugCI'">
        <OutputPath>bin\CI\</OutputPath>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>full</DebugType>
        <Optimize>true</Optimize>
        <DefineConstants>TRACE;DEBUGCI</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <OutputPath>bin\Release\</OutputPath>
        <DebugSymbols>false</DebugSymbols>
        <DebugType>none</DebugType>
        <Optimize>true</Optimize>
        <DefineConstants>RELEASE</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Beta'">
        <OutputPath>bin\Beta\</OutputPath>
        <DebugSymbols>false</DebugSymbols>
        <DebugType>none</DebugType>
        <Optimize>true</Optimize>
        <DefineConstants>BETA</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.4" />
        <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
        <PackageReference Include="Dapper" Version="2.1.79" />
        <PackageReference Include="DotNet.Glob" Version="3.1.3" />
        <PackageReference Include="Downloader" Version="5.9.4" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
        <PackageReference Include="protobuf-net" Version="3.2.56" />
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
        <PackageReference Include="SkiaSharp" Version="3.119.4" />
        <PackageReference Include="System.Net.Http" Version="4.3.4" />
        <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\PCL.Core\PCL.Core.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Using Include="System.Text.Json" />
        <Using Include="System.Text.Json.Nodes" />
    </ItemGroup>
    <ItemGroup>
        <Import Include="System.IO" />
        <Import Include="System.Net" />
        <Import Include="System.Text" />
        <Import Include="System.Threading" />
    </ItemGroup>
    <!-- 信不过巨硬的智障代码，手动包含需要的文件（沿用上游策略）
         [port] EnableDefaultItems 必须 true：Avalonia 命名字段生成器在 false 时整体失效；
         排除统一用 Remove 实现 -->
    <PropertyGroup>
        <EnableDefaultItems>true</EnableDefaultItems>
        <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
        <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    </PropertyGroup>
    <ItemGroup>
        <!-- 暂不移植的功能（用户指定，文件保留在仓库）：崩溃分析、音乐、视频背景、联机、换皮肤、Markdown 公告、工具页、剪贴板行为 -->
        <DeferredExcludes Include="
            Modules\Minecraft\CrashAnalysis\**;
            Modules\ModMusic.cs;
            Modules\ModVideoBack.cs;
            Modules\ModLink.cs;
            Modules\Minecraft\ModSkin.cs;
            Pages\PageTools\**;
            Controls\Behaviors\ClipboardInterceptor.cs;
            Controls\Behaviors\LazyLoadBehavior.cs;" />
        <Compile Remove="@(DeferredExcludes)" />
        <Compile Remove="Generated\**" />
        <!-- [port] Markdown.axaml 是 Markdown.Avalonia 主题样式（暂缓的 Markdown 公告功能资源），
             Avalonia 12 无法解析其 StyleKey。不仅要排除出 AvaloniaResource，还要从 AvaloniaXaml 编译源移除 -->
        <AvaloniaXaml Remove="Resources\Markdown.axaml" />
        <!-- [port] PageTools 为暂缓功能（见 DeferredExcludes），其 .cs 已 Compile Remove，
             但 .axaml 仍会被 AvaloniaXaml 默认 glob 收集并编译（报 Unable to find type PCL.PageTools*），故一并移除 -->
        <AvaloniaXaml Remove="Pages\PageTools\**" />
        <!-- [port] .cs/.axaml 由 SDK 默认 glob 收集（EnableDefaultItems 必须 true，否则 Avalonia 命名字段生成器失效）；这里只做排除 -->        <AvaloniaResource Include="Images\**" />
        <AvaloniaResource Include="Resources\**" Exclude="Resources\Markdown.axaml" />
        <EmbeddedResource Include="metadata.json" />
    </ItemGroup>
    <ItemGroup>
        <Content Include="LICENCE" />
    </ItemGroup>
    <PropertyGroup>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
    </PropertyGroup>
</Project>
